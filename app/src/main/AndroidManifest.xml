<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Vehicle SDK: 조회만 한다. 제어 권한은 선언하지 않는다 (docs/permissions-matrix.md) -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- registerTelltales의 @RequiresPermission (AAR 확인, 실측으로 필요 확인) -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- NaviHelper.requestRoute의 @RequiresPermission (AAR 확인, 실측으로 SecurityException 확인, normal) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 화면이 가려져도 차량 경고를 받기 위한 상시 서비스 (Phase 0 BG-03 실측) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 시연 모드 전용(기본 꺼짐): 에뮬레이터 안 Virtual Console(127.0.0.1:8088) 호출, 시연 패널·음성 창·흐름 창(떠 있는 창) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 시연 단계에서 내비 화면을 앞으로 가져온다 -->
    <queries>
        <package android:name="ai.umos.maps.android.navigation.app" />
    </queries>

    <application
        android:name=".CareApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CareAgent">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo AI 호출(assets/schema.json): "정비 기록해 줘" → 기록 확인 화면. 저장은 운전자 승인 뒤 -->
            <intent-filter>
                <action android:name="RECORD_MAINTENANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 주행 중에는 대화 카드와 큰 버튼만 보여 준다 (MainActivity 주행 모드) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- 대체 시연 패널(떠 있는 창 권한이 없을 때). 별도 task라 단계 실행 뒤 뒤로 보내면 직전 화면이 보인다 -->
        <activity
            android:name=".demo.DemoPanelActivity"
            android:exported="false"
            android:label="@string/demo_panel_name"
            android:launchMode="singleTask"
            android:taskAffinity="app.carecare.agent.demo">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <!-- 앱 목록의 "케어 시연 패널" 아이콘. 시연 모드를 켤 때만 활성화한다 -->
        <activity-alias
            android:name=".DemoPanelLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/demo_panel_name"
            android:targetActivity=".demo.DemoPanelActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".CareService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="차량 경고등과 정비소 방문을 화면이 꺼져 있어도 감지해 운전자에게 먼저 알리는 케어 에이전트" />
        </service>

        <!-- Gleo AI 호출(assets/schema.json): 차량 관리 상태 묻기. 읽기 전용이며 응답은 Gleo 패키지로만 보낸다 -->
        <receiver android:name=".gleo.GleoActionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="CHECK_CAR_CARE_STATUS" />
            </intent-filter>
        </receiver>

        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
